  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm dev:server & pnpm dev:client",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
