# Settings of one TOCTOC installation. Copy to .env (ignored by git), then chmod 600 .env: TOCTOC refuses a .env
# readable by other accounts, since it may hold secrets. Variables of the process environment win over this file,
# and this file wins over config.json.

# --- Application (server) ---
# INSEE code of the commune this server covers, not its postal code (Clichy-sous-Bois: 93014, postal code 93390).
# Also used by deploy/osrm/prepare-commune.sh for the street network of the itineraries.
TOCTOC_COMMUNE_INSEE=93014
# Directory of the database and of the imported files. Must be outside the repository.
TOCTOC_DATA_DIR=/var/lib/toctoc/data
# Encrypted backups. Must be outside the repository.
TOCTOC_BACKUP_DIR=/var/lib/toctoc/backups
# age public key the backups are encrypted to (bin/toctoc backup-key prints a new pair).
TOCTOC_BACKUP_RECIPIENT=
# Public address the application is served from.
TOCTOC_PUBLIC_ORIGIN=https://toctoc.example.org
TOCTOC_PORT=3000
TOCTOC_HOST=127.0.0.1
TOCTOC_OSRM_URL=http://127.0.0.1:5000
TOCTOC_VROOM_URL=http://127.0.0.1:3010

# --- Deployment (administrator's computer, bin/toctoc-deploy and bin/toctoc-check-cyber) ---
# ssh destination of the server.
TOCTOC_DEPLOY_HOST=mon-serveur
# Public name of the server, served in HTTPS.
TOCTOC_DOMAIN=toctoc.example.org
